# ============================================================
# XTrace hosted web app — SERVER-SIDE env only (Render / Next.js).
# Browser -> Next.js API -> Cloudflare Tunnel -> HPC GPU server
#                        -> Anthropic Claude (report reasoning)
#                        -> sponsor tools
#
# Nothing here may be exposed to the browser. Never prefix any of these with
# NEXT_PUBLIC_ (that inlines the value into the client bundle).
# ============================================================

NODE_ENV=production

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_NAME=XTrace
XTRACE_NO_MOCK=true
XTRACE_REQUIRE_REAL_MODEL_SERVER=true
XTRACE_STRICT_GPU_MODELS=true
XTRACE_ALLOW_PARTIAL_REPORTS=false
XTRACE_HIDE_INTERNAL_URLS=true

# ------------------------------------------------------------
# Render
# ------------------------------------------------------------
RENDER_SERVICE_NAME=xtrace
RENDER_ENV=production
RENDER_EXTERNAL_URL=

# ------------------------------------------------------------
# HPC GPU model server via Cloudflare Tunnel
# ------------------------------------------------------------
MODEL_SERVER_URL=https://YOUR-CLOUDFLARE-TUNNEL.trycloudflare.com
MODEL_SERVER_MULTIMODAL_ROUTE=/v1/analyze/multimodal
MODEL_SERVER_HEALTH_ROUTE=/health
MODEL_SERVER_MODELS_ROUTE=/models
MODEL_SERVER_GPU_ROUTE=/gpu
MODEL_SERVER_TIMEOUT_MS=300000
MODEL_SERVER_MAX_UPLOAD_MB=200

# Required model names expected from GPU server
REQUIRED_IMAGE_MODELS=UniversalFakeDetect,capcheck/ai-human-generated-image-detection
REQUIRED_AUDIO_MODELS=AASIST,garystafford/wav2vec2-deepfake-voice-detector
REQUIRED_VIDEO_MODELS=MesoNet,Temporal Analyzer
REQUIRED_PROVENANCE_MODELS=Provenance
REQUIRED_MODELS_STRICT=true

# ------------------------------------------------------------
# Anthropic Claude forensic reasoning (report writer only).
# Used ONLY after the HPC server returns real detector signals.
# Claude summarizes evidence and never alters detector scores.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_REPORT_MODEL=claude-sonnet-4-6
ANTHROPIC_REPORT_FALLBACK_MODEL=claude-haiku-4-5
ANTHROPIC_HIGH_QUALITY_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_TOKENS=1800
ANTHROPIC_TEMPERATURE=0.2

# ------------------------------------------------------------
# Guild webhook integration (no Guild API key required)
# ------------------------------------------------------------
GUILD_ENABLED=true
GUILD_WEBHOOK_URL=
GUILD_WEBHOOK_SIGNING_SECRET=
GUILD_WEBHOOK_SIGNATURE_HEADER=X-Guild-Signature
GUILD_WEBHOOK_EVENT_TYPE=xtrace.analysis.completed

# ------------------------------------------------------------
# Composio = action layer (GitHub issue / Slack summary / optional Notion).
# ------------------------------------------------------------
COMPOSIO_ENABLED=true
COMPOSIO_API_KEY=
COMPOSIO_API_BASE_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_GITHUB_OWNER=
COMPOSIO_GITHUB_REPO=
COMPOSIO_GITHUB_CREATE_ISSUE_TOOL=GITHUB_CREATE_AN_ISSUE
COMPOSIO_SLACK_CHANNEL_ID=
COMPOSIO_SLACK_SEND_MESSAGE_TOOL=SLACK_SENDS_A_MESSAGE_TO_A_SLACK_CHANNEL
COMPOSIO_NOTION_DATABASE_ID=
COMPOSIO_NOTION_CREATE_PAGE_TOOL=

# ------------------------------------------------------------
# Jua = optional reality-context (weather/location/time claim plausibility).
# Only runs when the user supplies a relevant claim.
# ------------------------------------------------------------
JUA_ENABLED=true
JUA_API_KEY=
JUA_BASE_URL=
JUA_DEFAULT_MODEL=ept-2
# Legacy split-key format also supported:
# JUA_API_KEY_ID=
# JUA_API_SECRET=

# ------------------------------------------------------------
# OpenUI = dynamic report blocks (built-in; default on).
# ------------------------------------------------------------
OPENUI_ENABLED=true
OPENUI_SAFE_RENDER_ONLY=true

# ------------------------------------------------------------
# Upload limits
# ------------------------------------------------------------
MAX_IMAGE_MB=25
MAX_AUDIO_MB=50
MAX_VIDEO_MB=200

# Do NOT use (secrets must never reach the browser):
# NEXT_PUBLIC_MODEL_SERVER_URL
# NEXT_PUBLIC_ANTHROPIC_API_KEY
# NEXT_PUBLIC_GUILD_WEBHOOK_URL
# NEXT_PUBLIC_COMPOSIO_API_KEY
# NEXT_PUBLIC_JUA_API_KEY
